OIDC_PROVIDER_HINT_GOOGLE=
OIDC_PROVIDER_HINT_MICROSOFT=
OIDC_PROVIDER_HINT_APPLE=

APP_TOKEN_SECRET=CAMBIA_ESTE_VALOR_SEGURO
APP_TOKEN_TTL_SECONDS=28800

LOGIN_FRONT_URL=https://tu-dominio.com/login
CLIENTS_APP_URL=https://tu-dominio.com/app

REQUIRE_ALLOWLIST=true
ALLOWED_EMAILS=santiagomejia.r02@gmail.com

SSO_STATE_TTL_SECONDS=900

# External metrics API (securely consumed by backend)
# Prefer definir SOLO una de estas dos estrategias:
# 1) URL completa con key:
# METRICS_API_URL=https://client3-back-uat-centralus.azurewebsites.net/api/GetMetrics?code=TU_KEY
# 2) Plantilla + variables:
METRICS_API_URL=
METRICS_API_URL_TEMPLATE=https://client3-back-{{env}}-centralus.azurewebsites.net/api/GetMetrics?code={{key}}
METRICS_API_ENV=uat
METRICS_API_KEY=
# If your API expects key in header, enable these:
METRICS_API_KEY_IN_HEADER=false
METRICS_API_KEY_HEADER_NAME=x-functions-key
METRICS_TIMEOUT_SECONDS=15

# Runtime config for frontend apps (served by backend /runtime-config.js)
VITE_API_URL=/api
VITE_WEBSITE_URL=/
VITE_LOGIN_URL=/login
VITE_LOGIN_APP_URL=/login
VITE_SITE_URL=https://tu-dominio.com
