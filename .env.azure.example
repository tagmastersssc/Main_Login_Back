# Entra
OIDC_TENANT_ID=7b128625-9864-4389-b07c-3e139e7559cd
OIDC_CLIENT_ID=b68d24e8-db81-48fc-999f-bc6f78e2e6ae
OIDC_CLIENT_SECRET=
OIDC_PUBLIC_CLIENT=false
# Si quieres aceptar cuentas corporativas de otros tenants:
