DATABASE_PATH=users.db
ALLOWED_ORIGINS=https://tu-login-front.com,https://tu-clients-front.com

ENABLE_PASSWORD_AUTH=false

# Entra
OIDC_TENANT_ID=7b128625-9864-4389-b07c-3e139e7559cd
OIDC_CLIENT_ID=b68d24e8-db81-48fc-999f-bc6f78e2e6ae
OIDC_CLIENT_SECRET=
OIDC_PUBLIC_CLIENT=false
# Si quieres aceptar cuentas corporativas de otros tenants:
# OIDC_DISCOVERY_URL=https://login.microsoftonline.com/organizations/v2.0/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
OIDC_SCOPE=openid profile email
OIDC_ISSUER=

# Debe existir en App Registration
SSO_REDIRECT_URI=https://tu-dominio.com/api/auth/sso/callback

# Solo si usas Entra como broker social con hints
OIDC_PROVIDER_HINT_PARAM=idp
OIDC_PROVIDER_HINT_GOOGLE=
OIDC_PROVIDER_HINT_MICROSOFT=
OIDC_PROVIDER_HINT_APPLE=

APP_TOKEN_SECRET=CAMBIA_ESTE_VALOR_SEGURO
APP_TOKEN_TTL_SECONDS=28800
SESSION_COOKIE_NAME=bilai_portal_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_SECURE=true

LOGIN_FRONT_URL=https://tu-dominio.com/login
CLIENTS_APP_URL=
CLIENTS_BACKEND_URL=
DEFAULT_TENANT_ID=
TENANT_EXCHANGE_SECRET=
TENANT_LOGIN_CODE_TTL_SECONDS=300
# Aquí `tenant` significa slug lógico del cliente dentro de BilAI, no tenant de Azure Entra.
# Ejemplo:
# TENANT_CONFIG_JSON={"client1":{"clients_front_url":"https://client1.bilai.co","clients_backend_url":"https://client1-api.bilai.co","exchange_secret":"CAMBIA_ESTE_SECRETO","allowed_emails":["owner@client1.com"],"allowed_email_domains":["client1.com"]}}
TENANT_CONFIG_JSON=

REQUIRE_ALLOWLIST=true
ALLOWED_EMAILS=

SSO_STATE_TTL_SECONDS=900

# External metrics API (securely consumed by backend)
# Prefer definir SOLO una de estas dos estrategias:
# 1) URL completa con key:
# METRICS_API_URL=https://client3-back-uat-centralus.azurewebsites.net/api/Metrics?code=TU_KEY
# 2) Plantilla + variables:
METRICS_API_URL=
METRICS_API_URL_TEMPLATE=https://client3-back-{{env}}-centralus.azurewebsites.net/api/Metrics?code={{key}}
METRICS_API_ENV=uat
METRICS_API_KEY=
# If your API expects key in header, enable these:
METRICS_API_KEY_IN_HEADER=false
METRICS_API_KEY_HEADER_NAME=x-functions-key
METRICS_TIMEOUT_SECONDS=15
EXTERNAL_API_BASE_URL=

# Runtime config for frontend apps (served by backend /runtime-config.js)
VITE_API_URL=/api
VITE_WEBSITE_URL=/
VITE_LOGIN_URL=/login
VITE_LOGIN_APP_URL=/login
VITE_SITE_URL=https://tu-dominio.com
VITE_WHATSAPP_URL=https://wa.me/573001112233?text=Hola%20BilAI%2C%20quiero%20conocer%20la%20plataforma.
VITE_CONTACT_EMAIL=ventas@bilai.com
VITE_GA_MEASUREMENT_ID=
