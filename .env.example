# =========================
# Core app settings
# =========================
DATABASE_PATH=users.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# =========================
# Password login (legacy)
# Keep false to enforce SSO-only
# =========================
ENABLE_PASSWORD_AUTH=false

# =========================
# OIDC / Entra SSO
# Configure Entra (or your IdP) OpenID Connect metadata URL
# Multi-tenant example:
# OIDC_DISCOVERY_URL=https://login.microsoftonline.com/organizations/v2.0/.well-known/openid-configuration
# =========================
OIDC_DISCOVERY_URL=
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Recomendado para este backend: false (confidential client + secret)
# Usa true solo si tu app en Entra es public client.
OIDC_PUBLIC_CLIENT=false
OIDC_SCOPE=openid profile email

# Optional issuer override if needed
OIDC_ISSUER=

# Callback URL (must match App Registration redirect URI)
SSO_REDIRECT_URI=http://localhost:8000/auth/sso/callback

# Provider hint settings (useful when Entra is broker for Google/Microsoft/Apple)
# For Entra External ID often the parameter is `idp`.
OIDC_PROVIDER_HINT_PARAM=idp
OIDC_PROVIDER_HINT_GOOGLE=
OIDC_PROVIDER_HINT_MICROSOFT=
OIDC_PROVIDER_HINT_APPLE=

# =========================
# BilAI portal token
# =========================
APP_TOKEN_SECRET=change-this-in-production
APP_TOKEN_TTL_SECONDS=28800
SESSION_COOKIE_NAME=bilai_portal_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# =========================
# Redirect targets
# =========================
LOGIN_FRONT_URL=http://localhost:5173
CLIENTS_APP_URL=http://localhost:5174

# =========================
# Access control
# If REQUIRE_ALLOWLIST=true, only emails listed in ALLOWED_EMAILS can sign in
# =========================
REQUIRE_ALLOWLIST=true
ALLOWED_EMAILS=admin@tuempresa.com,owner@tuempresa.com

# SSO state lifetime in seconds
SSO_STATE_TTL_SECONDS=900

# =========================
# External metrics API (used by Clients_Invoice_Front via backend proxy)
# Use ONE strategy:
# 1) Direct URL:
#    METRICS_API_URL=https://client3-back-uat-centralus.azurewebsites.net/api/Metrics?code=...
# 2) URL template:
#    METRICS_API_URL_TEMPLATE=https://client3-back-{{env}}-centralus.azurewebsites.net/api/Metrics?code={{key}}
#    METRICS_API_ENV=uat
#    METRICS_API_KEY=...
# =========================
METRICS_API_URL=
METRICS_API_URL_TEMPLATE=
METRICS_API_ENV=
METRICS_API_KEY=
# Optional: send API key via header instead of query param (code=...)
METRICS_API_KEY_IN_HEADER=false
METRICS_API_KEY_HEADER_NAME=x-functions-key
METRICS_TIMEOUT_SECONDS=15
EXTERNAL_API_BASE_URL=

# =========================
# Frontend runtime config (served at /runtime-config.js)
# Terraform can manage these without rebuilding frontends
# =========================
VITE_API_URL=/api
VITE_WEBSITE_URL=/
VITE_LOGIN_URL=/login
VITE_LOGIN_APP_URL=/login
VITE_SITE_URL=
VITE_WHATSAPP_URL=https://wa.me/573001112233?text=Hola%20BilAI%2C%20quiero%20conocer%20la%20plataforma.
VITE_CONTACT_EMAIL=hola@bilai.co
VITE_GA_MEASUREMENT_ID=
